<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
        ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD — StripeConfig.init()
        Pattern imposé par le SDK Stripe Java : Stripe.apiKey est un champ statique
        public qui doit être assigné au démarrage. Aucune alternative sans refonte
        complète vers StripeClient (hors scope MVP).
    -->
    <Match>
        <Class name="com.dony.api.config.StripeConfig"/>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    </Match>

    <!--
        ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD — EncryptionSupport
        Pont Spring→JPA : un AttributeConverter est instancié par Hibernate, pas
        par Spring, donc EncryptionService ne peut pas y être injecté. Ce composant
        le capture dans un champ statique volatile au démarrage du contexte (avant
        toute requête Hibernate), lu ensuite par le converter. Écriture unique au
        boot, lecture thread-safe. Même pattern accepté que StripeConfig ci-dessus.
    -->
    <Match>
        <Class name="com.dony.api.common.EncryptionSupport"/>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    </Match>
</FindBugsFilter>